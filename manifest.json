{
  "manifest_version": 3,
  "name": "Profile Groups",
  "version": "0.1.0",
  "description": "Give each tab group its own logins. Works offline, collects nothing.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "permissions": ["tabs", "tabGroups", "cookies", "storage", "unlimitedStorage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Profile Groups",
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  }
}
